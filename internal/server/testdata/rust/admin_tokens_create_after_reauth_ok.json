{
  "name": "admin_tokens_create_after_reauth_ok",
  "request": {
    "method": "POST",
    "path": "/api/domus/tokens",
    "headers": {
      "Content-Type": "application/json",
      "Cookie": "domus_session=<HEX64>"
    },
    "body": {
      "name": "created-from-app-session"
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "content-type": "application/json",
      "cache-control": "no-store",
      "content-security-policy": "default-src 'self'; img-src 'self' data:; base-uri 'none'; form-action 'self'; frame-ancestors 'none'",
      "x-content-type-options": "nosniff",
      "x-frame-options": "DENY",
      "referrer-policy": "no-referrer"
    },
    "body": {
      "id": 18,
      "name": "created-from-app-session",
      "token": "<TOKEN>"
    }
  }
}
