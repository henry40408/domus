{
  "name": "admin_password_wrong_current_401",
  "request": {
    "method": "POST",
    "path": "/api/domus/password",
    "headers": {
      "Content-Type": "application/json",
      "Cookie": "domus_session=<HEX64>"
    },
    "body": {
      "current": "wrong password!",
      "new": "dave-changed-pass-2"
    }
  },
  "response": {
    "status": 401,
    "headers": {
      "content-type": "application/json",
      "cache-control": "no-store",
      "content-security-policy": "default-src 'self'; img-src 'self' data:; base-uri 'none'; form-action 'self'; frame-ancestors 'none'",
      "x-content-type-options": "nosniff",
      "x-frame-options": "DENY",
      "referrer-policy": "no-referrer"
    },
    "body": {
      "message": "Current password is wrong."
    }
  }
}
