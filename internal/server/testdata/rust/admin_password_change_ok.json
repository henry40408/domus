{
  "name": "admin_password_change_ok",
  "request": {
    "method": "POST",
    "path": "/api/domus/password",
    "headers": {
      "Content-Type": "application/json",
      "Cookie": "domus_session=<HEX64>"
    },
    "body": {
      "current": "dave-initial-pass-1",
      "new": "dave-changed-pass-2"
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "content-type": "application/json",
      "cache-control": "no-store",
      "content-security-policy": "default-src 'self'; img-src 'self' data:; base-uri 'none'; form-action 'self'; frame-ancestors 'none'",
      "x-content-type-options": "nosniff",
      "x-frame-options": "DENY",
      "referrer-policy": "no-referrer",
      "set-cookie": "domus_session=<HEX64>; HttpOnly; SameSite=Strict; Path=/; Max-Age=604800"
    },
    "body": {
      "ok": true
    }
  }
}
